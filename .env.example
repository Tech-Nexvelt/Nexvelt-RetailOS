# Copy to .env.local (git-ignored). Never commit real values and never paste them into chat.

# DEVELOPMENT ONLY: the in-memory demo billing backend with fictitious data and NO sign-in.
# Real deployments set BILLING_BACKEND=supabase. Leaving it unset makes billing refuse to run (fail closed).
BILLING_BACKEND=demo
# BILLING_BACKEND=supabase

# RetailOS has its OWN, DEDICATED Supabase project (never the Tirumala one). It uses the schema `retailos`
# (set in code, src/lib/env.ts), which must also be listed under Settings > API > Exposed schemas.
NEXT_PUBLIC_SUPABASE_URL=
# Either name works; the publishable name wins when both are set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used to build links in emails. Required: taken from configuration, never from request headers.
NEXT_PUBLIC_SITE_URL=

# Server-only. Never give either name a NEXT_PUBLIC_ prefix. Used only for Auth admin calls (inviting users).
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------------------------------------
# OPERATOR-ONLY variables (used by scripts/ on YOUR machine, in .env.local). The application NEVER reads them
# and they must NOT be set in the hosting platform. Set them with `node scripts/set-secret.mjs`, not by hand.
# RETAILOS_SUPABASE_PROJECT_REF=      20-character project ref (not a secret)
# RETAILOS_DATABASE_URL=              session-pooler connection string, port 5432 (secret)
# RETAILOS_DB_CA_FILE=                path to the Supabase root CA (public certificate); keeps TLS verification ON
# SUPABASE_ACCESS_TOKEN=              Management API token (secret); not needed for --db-only scripts
