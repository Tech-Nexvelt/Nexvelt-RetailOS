{
  "name": "nexvelt-retailos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "test:db": "vitest run -c vitest.db.config.mts",
    "migrations:seal": "node scripts/seal-migrations.mjs",
    "retailos:port": "node scripts/port-to-retailos.mjs && node scripts/seal-migrations.mjs supabase/retailos/migrations",
    "retailos:seal": "node scripts/seal-migrations.mjs supabase/retailos/migrations",
    "retailos:manifest": "node scripts/retailos-manifest.mjs",
    "retailos:manifest:check": "node scripts/retailos-manifest.mjs --check",
    "retailos:verify:update": "node scripts/verify-update.mjs",
    "retailos:verify:schema": "node scripts/verify-schema.mjs",
    "schema:app-check": "node scripts/check-app-schema.mjs",
    "env:check": "node scripts/env-check.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "predeploy": "npm run typecheck && npm run lint && npm test && npm run schema:app-check && npm run retailos:manifest:check && npm run build",
    "smoke:deployed": "node scripts/smoke-deployed.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.2",
    "pg": "8.23.1",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "packageManager": "npm@10.9.8"
}
